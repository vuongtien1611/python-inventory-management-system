# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# IDE / Editors
.idea/
.vscode/
*.swp
*.swo

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db

# Dữ liệu sinh ra khi chạy chương trình (tránh commit dữ liệu thử nghiệm)
data/*.json
data/*.csv
*.log

# Giữ lại file .gitkeep để Git theo dõi thư mục rỗng
!data/.gitkeep
!docs/**/.gitkeep

